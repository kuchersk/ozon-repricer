{
  "manifest_version": 3,
  "name": "Проверка серой цены Ozon",
  "version": "0.7.0",
  "minimum_chrome_version": "120",
  "description": "Сбор цен витрины Ozon: М3 и пилот трёх товаров без изменения цен.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "options_page": "options.html",
  "optional_host_permissions": [
    "https://*/*"
  ]
}
